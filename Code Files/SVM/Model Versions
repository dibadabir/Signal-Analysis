        y_prob_epoch=fold_val_prob,
        groups_epoch=g_va_fold,
        threshold=0.5
    )

    fold_best_thr_subj, _ = find_best_threshold(
        fold_subj_df["y_true"].values,
        fold_subj_df["y_prob"].values,
        priority="recall_f1"
    )
    fold_subj_df["y_pred"] = (fold_subj_df["y_prob"] >= fold_best_thr_subj).astype(int)

    fold_metrics_subj = evaluate_binary(
        fold_subj_df["y_true"].values,
        fold_subj_df["y_pred"].values,
        fold_subj_df["y_prob"].values,
        level_name=f"Fold {fold_idx} subject-level"
    )
