# 9. Manual fold-by-fold validation on training set
# ------------------------------------------------------------
print("\n================ MANUAL FOLD VALIDATION ================")

manual_cv = GroupKFold(n_splits=n_splits_cv)
best_params = grid.best_params_

fold_model_template = Pipeline([
    ("var_thresh", VarianceThreshold()),
    ("scaler", StandardScaler()),
    ("select", SelectKBest(score_func=f_classif, k=min(K_BEST_FEATURES, X_train.shape[1]))),
    ("svm", SVC(
        probability=True,
        class_weight="balanced" if USE_CLASS_WEIGHT else None,
        random_state=RANDOM_STATE
    ))
])
fold_model_template.set_params(**best_params)

fold_rows_epoch = []
fold_rows_subject = []
best_fold_idx = None
best_fold_score = -np.inf
best_fold_model = None
best_fold_subject_df = None

for fold_idx, (tr_idx, va_idx) in enumerate(manual_cv.split(X_train, y_train, groups=g_train), start=1):
    print(f"\n---------------- FOLD {fold_idx} ----------------")

    X_tr_fold, y_tr_fold, g_tr_fold = X_train[tr_idx], y_train[tr_idx], g_train[tr_idx]
    X_va_fold, y_va_fold, g_va_fold = X_train[va_idx], y_train[va_idx], g_train[va_idx]

    print("Train subjects:", len(np.unique(g_tr_fold)), "| epochs:", len(X_tr_fold))
    print("Val subjects:  ", len(np.unique(g_va_fold)), "| epochs:", len(X_va_fold))

    fold_model = clone(fold_model_template)
    fold_model.fit(X_tr_fold, y_tr_fold)

    fold_val_prob = fold_model.predict_proba(X_va_fold)[:, 1]

    # automatic epoch threshold
    fold_best_thr_epoch, _ = find_best_threshold(y_va_fold, fold_val_prob, priority="recall_f1")
    fold_val_pred_epoch = (fold_val_prob >= fold_best_thr_epoch).astype(int)

    fold_metrics_epoch = evaluate_binary(
        y_va_fold,
        fold_val_pred_epoch,
        fold_val_prob,
        level_name=f"Fold {fold_idx} epoch-level"
    )
    fold_metrics_epoch["fold"] = fold_idx
    fold_metrics_epoch["threshold"] = float(fold_best_thr_epoch)
    fold_metrics_epoch["n_val_epochs"] = len(X_va_fold)
    fold_metrics_epoch["n_val_subjects"] = len(np.unique(g_va_fold))
    fold_rows_epoch.append(fold_metrics_epoch)

    print("Epoch-level metrics:")
    for k, v in fold_metrics_epoch.items():
        if k not in ["level", "fold", "n_val_epochs", "n_val_subjects"]:
            print(f"  {k}: {v:.4f}" if isinstance(v, float) else f"  {k}: {v}")

    fold_subj_df = subject_level_predictions(
