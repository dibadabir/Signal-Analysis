grid = GridSearchCV(
    estimator=pipeline,
    param_grid=param_grid,
    scoring="roc_auc",
    cv=inner_cv,
    n_jobs=-1,
    verbose=1,
    refit=True
)

print("\nRunning GridSearchCV...")
grid.fit(X_train, y_train, groups=g_train)

