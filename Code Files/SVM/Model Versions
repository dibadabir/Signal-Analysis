def parse_file_label(file_path: Path):
    stem = file_path.name.replace("-epo.fif", "")
    parts = stem.split("_")
    if len(parts) != 2:
        return None, None
    subj = parts[0].replace("sub-", "")
    label = parts[1]
    return subj, label


def safe_divide(a, b):
    return np.divide(a, b, out=np.zeros_like(a), where=(b != 0))


def compute_bandpower_maps(data, sfreq, bands):
    """
    data shape: (n_epochs, n_channels, n_times)
    returns dict band_name -> (n_epochs, n_channels)
    """
    band_dict = {}

    n_times = data.shape[-1]
    n_per_seg = min(int(sfreq), n_times)        # about 1 second window
    n_fft = min(512, max(128, n_times))         # better for 250 Hz than old 256-only setting
    n_overlap = n_per_seg // 2 if n_per_seg >= 4 else 0

    for band_name, (fmin, fmax) in bands.items():
        psd_out = mne.time_frequency.psd_array_welch(
            data,
            sfreq=sfreq,
            fmin=fmin,
            fmax=fmax,
            n_per_seg=n_per_seg,
            n_fft=n_fft,
            n_overlap=n_overlap,
            average="mean",
            verbose=False
        )

        if isinstance(psd_out, tuple):
            psd, freqs = psd_out
        else:
            psd = psd_out

        band_dict[band_name] = psd.mean(axis=-1)

    return band_dict


def extract_features_from_epochs(epochs, bands):
    """
    Feature extraction for target-only EEG epochs.

    Features:
    - absolute bandpower
    - log absolute bandpower
    - relative bandpower
    - spectral ratios
    - time-domain statistics
    - global summary features
    """
    data = epochs.get_data().astype(np.float32)
    sfreq = float(epochs.info["sfreq"])
    ch_names = epochs.ch_names

    feature_blocks = []
    feature_names = []

    # 1. Absolute bandpower
    band_dict = compute_bandpower_maps(data, sfreq, bands)

    for band_name in bands.keys():
        bp = band_dict[band_name]
        feature_blocks.append(bp)
        feature_names.extend([f"{ch}_{band_name}_abs" for ch in ch_names])

    # 2. Log absolute bandpower
    for band_name in bands.keys():
        log_bp = np.log1p(np.maximum(band_dict[band_name], 0))
        feature_blocks.append(log_bp)
        feature_names.extend([f"{ch}_{band_name}_logabs" for ch in ch_names])

    # 3. Relative bandpower
    total_power = np.zeros_like(next(iter(band_dict.values())))
    for band_name in bands.keys():
        total_power += band_dict[band_name]

    for band_name in bands.keys():
        rel = safe_divide(band_dict[band_name], total_power)
        feature_blocks.append(rel)
        feature_names.extend([f"{ch}_{band_name}_rel" for ch in ch_names])

    # 4. Ratios
    ratio_defs = {
        "theta_beta_ratio": ("theta", "beta"),
        "alpha_theta_ratio": ("alpha", "theta"),
        "delta_beta_ratio": ("delta", "beta"),
        "theta_alpha_ratio": ("theta", "alpha"),
        "alpha_beta_ratio": ("alpha", "beta"),
    }

    for ratio_name, (num_band, den_band) in ratio_defs.items():
        ratio = safe_divide(band_dict[num_band], band_dict[den_band])
        feature_blocks.append(ratio)
        feature_names.extend([f"{ch}_{ratio_name}" for ch in ch_names])

    # 5. Time-domain stats
    mean_feat = data.mean(axis=2)
    std_feat  = data.std(axis=2)
    var_feat  = data.var(axis=2)
    rms_feat  = np.sqrt(np.mean(data ** 2, axis=2))
    ptp_feat  = np.ptp(data, axis=2)
    absmean_feat = np.mean(np.abs(data), axis=2)

    stat_blocks = [
        ("mean", mean_feat),
        ("std", std_feat),
        ("var", var_feat),
        ("rms", rms_feat),
        ("ptp", ptp_feat),
        ("absmean", absmean_feat),
    ]

    for stat_name, stat_array in stat_blocks:
        feature_blocks.append(stat_array)
        feature_names.extend([f"{ch}_{stat_name}" for ch in ch_names])

    # 6. Global summary features
    global_blocks = []

    for band_name in bands.keys():
        g_abs = band_dict[band_name].mean(axis=1, keepdims=True)
        global_blocks.append((f"global_{band_name}_abs", g_abs))

    for band_name in bands.keys():
        g_rel = safe_divide(band_dict[band_name], total_power).mean(axis=1, keepdims=True)
        global_blocks.append((f"global_{band_name}_rel", g_rel))

    global_blocks.extend([
        ("global_mean", mean_feat.mean(axis=1, keepdims=True)),
        ("global_std", std_feat.mean(axis=1, keepdims=True)),
        ("global_var", var_feat.mean(axis=1, keepdims=True)),
        ("global_rms", rms_feat.mean(axis=1, keepdims=True)),
        ("global_ptp", ptp_feat.mean(axis=1, keepdims=True)),
        ("global_absmean", absmean_feat.mean(axis=1, keepdims=True)),
    ])

    for name, arr in global_blocks:
        feature_blocks.append(arr)
        feature_names.append(name)

    X = np.concatenate(feature_blocks, axis=1).astype(np.float32)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    return X, feature_names


def load_dataset_from_fif(cache_dir, pd_label="OFF", ctl_label="CTL"):
    X_list = []
    y_list = []
    groups = []
    summary_rows = []
    feature_names = None

    files = sorted(cache_dir.glob("sub-*-epo.fif"))
    if len(files) == 0:
        raise FileNotFoundError(f"No .fif files found in {cache_dir}")

    for fp in files:
        subj, label = parse_file_label(fp)
        if subj is None:
            continue

        if label not in {pd_label, ctl_label}:
            continue

        y = 1 if label == pd_label else 0

        try:
            epochs = mne.read_epochs(fp, preload=True, verbose=False)
            if len(epochs) == 0:
                print(f"Skipping {fp.name}: no epochs")
                continue

            X_subj, feat_names = extract_features_from_epochs(epochs, BANDS)
            if feature_names is None:
                feature_names = feat_names

            X_list.append(X_subj)
            y_list.append(np.full(len(X_subj), y, dtype=int))
            groups.extend([subj] * len(X_subj))

            summary_rows.append({
                "subject": subj,
                "label_name": label,
                "class": y,
                "n_epochs": len(epochs),
                "n_channels": len(epochs.ch_names),
                "sfreq": epochs.info["sfreq"],
                "epoch_tmin": epochs.tmin,
                "epoch_tmax": epochs.tmax,
                "n_features": X_subj.shape[1]
            })

            print(f"Loaded {fp.name} | class={y} | epochs={len(epochs)} | features={X_subj.shape[1]}")

        except Exception as e:
            print(f"Failed on {fp.name}: {e}")

    if len(X_list) == 0:
        raise RuntimeError("No usable OFF vs CTL data found.")

    X = np.vstack(X_list)
    y = np.concatenate(y_list)
    groups = np.array(groups)
    summary_df = pd.DataFrame(summary_rows)

    return X, y, groups, feature_names, summary_df


def cap_epochs_per_subject(X, y, groups, max_epochs_per_subject=None, random_state=42):
    if max_epochs_per_subject is None:
        return X, y, groups

    rng = np.random.default_rng(random_state)
    keep_indices = []

    unique_subjects = np.unique(groups)
    for subj in unique_subjects:
        subj_idx = np.where(groups == subj)[0]
        if len(subj_idx) > max_epochs_per_subject:
            subj_idx = rng.choice(subj_idx, size=max_epochs_per_subject, replace=False)
        keep_indices.extend(subj_idx.tolist())

    keep_indices = np.array(sorted(keep_indices))
    return X[keep_indices], y[keep_indices], groups[keep_indices]


def balance_training_data_by_undersampling(X, y, groups, random_state=42):
    rng = np.random.default_rng(random_state)

    idx_class_0 = np.where(y == 0)[0]
    idx_class_1 = np.where(y == 1)[0]

    n0 = len(idx_class_0)
    n1 = len(idx_class_1)

    print(f"Before balancing -> Control: {n0}, PD: {n1}")

    if n0 == n1:
        print("Training set already balanced.")
        return X, y, groups

    if n0 > n1:
        idx_class_0 = rng.choice(idx_class_0, size=n1, replace=False)
    else:
        idx_class_1 = rng.choice(idx_class_1, size=n0, replace=False)

    keep_idx = np.concatenate([idx_class_0, idx_class_1])
    rng.shuffle(keep_idx)

    X_bal = X[keep_idx]
    y_bal = y[keep_idx]
    g_bal = groups[keep_idx]

    print(f"After balancing  -> Control: {np.sum(y_bal == 0)}, PD: {np.sum(y_bal == 1)}")
    print(f"Training subjects still present: {len(np.unique(g_bal))}")

    return X_bal, y_bal, g_bal


def subject_level_predictions(y_true_epoch, y_prob_epoch, groups_epoch, threshold=0.5):
    df = pd.DataFrame({
        "subject": groups_epoch,
        "y_true": y_true_epoch,
        "y_prob": y_prob_epoch
    })

    subj_df = (
        df.groupby("subject")
          .agg(
              y_true=("y_true", "first"),
              y_prob=("y_prob", "mean"),
              n_epochs=("y_prob", "size"),
              y_prob_std=("y_prob", "std")
          )
          .reset_index()
    )

    subj_df["y_prob_std"] = subj_df["y_prob_std"].fillna(0.0)
    subj_df["y_pred"] = (subj_df["y_prob"] >= threshold).astype(int)
    return subj_df


def evaluate_binary(y_true, y_pred, y_prob, level_name=""):
    return {
        "level": level_name,
        "accuracy": accuracy_score(y_true, y_pred),
        "precision": precision_score(y_true, y_pred, zero_division=0),
        "recall": recall_score(y_true, y_pred, zero_division=0),
        "f1": f1_score(y_true, y_pred, zero_division=0),
        "roc_auc": roc_auc_score(y_true, y_prob) if len(np.unique(y_true)) > 1 else np.nan
    }


def print_metrics(title, metrics_dict):
    print(f"\n================ {title} ================")
    for k, v in metrics_dict.items():
        if k != "level":
            print(f"{k}: {v:.4f}")


def find_best_threshold(y_true, y_prob, priority="f1_recall"):
    rows = []

    for thr in np.arange(0.30, 0.71, 0.01):
        y_pred = (y_prob >= thr).astype(int)
        rows.append({
            "threshold": thr,
            "f1": f1_score(y_true, y_pred, zero_division=0),
            "recall": recall_score(y_true, y_pred, zero_division=0),
            "precision": precision_score(y_true, y_pred, zero_division=0),
            "accuracy": accuracy_score(y_true, y_pred),
        })

    thr_df = pd.DataFrame(rows)

    if priority == "recall_f1":
        best_row = thr_df.sort_values(["recall", "f1", "accuracy"], ascending=False).iloc[0]
    else:
        best_row = thr_df.sort_values(["f1", "recall", "accuracy"], ascending=False).iloc[0]

    return float(best_row["threshold"]), thr_df


