def force_eeg_channel_types(raw: mne.io.BaseRaw) -> mne.io.BaseRaw:
    """Ensure standard EEG channels are treated as EEG."""
    eeg_like = {
        "FP1", "FP2", "F3", "F4", "FZ", "FC1", "FC2", "FCZ",
        "C3", "C4", "CZ", "P3", "P4", "PZ", "T7", "T8",
        "F7", "F8", "C1", "C2", "C5", "C6", "P7", "P8",
        "O1", "O2", "OZ", "AF3", "AF4", "AF7", "AF8",
        "FT7", "FT8", "TP7", "TP8", "CP1", "CP2", "CP3", "CP4",
        "CP5", "CP6", "PO3", "PO4", "PO7", "PO8", "POZ",
        "P1", "P2", "P5", "P6", "F1", "F2", "F5", "F6",
        "FC3", "FC4", "FC5", "FC6"
    }

    mapping = {ch: "eeg" for ch in raw.ch_names if ch.strip().upper() in eeg_like}
    if mapping:
        raw.set_channel_types(mapping)

    eog_mapping = {
        ch: "eog" for ch in raw.ch_names
        if ch.strip().upper() in {"VEOG", "HEOG", "EOG"}
    }
    if eog_mapping:
        raw.set_channel_types(eog_mapping)

    return raw


def safe_set_montage(raw: mne.io.BaseRaw, coord_system: Optional[str] = None) -> None:
    """Apply a standard 10-20 montage when possible."""
    if coord_system and coord_system.upper() not in {"OTHER", "STANDARD_1020", "10-20", "ARS"}:
        logger.warning(f"Coordinate system reported as '{coord_system}'")

    try:
        raw.set_montage("standard_1020", on_missing="ignore")
    except Exception:
        pass


def safe_set_reference(
    raw: mne.io.BaseRaw,
    ref_ch: Optional[str] = None,
    ground_ch: Optional[str] = None
) -> None:
    """Apply average EEG reference safely."""
    try:
        if ground_ch and ground_ch in raw.ch_names:
            raw.set_channel_types({ground_ch: "misc"})
            logger.info(f"Ground channel '{ground_ch}' excluded from EEG picks.")

        if ref_ch and ref_ch not in raw.ch_names:
            raw.add_reference_channels(ref_ch)
            logger.info(f"Original reference '{ref_ch}' added back before re-referencing.")

        raw.set_eeg_reference("average", projection=False)

    except Exception as e:
        logger.warning(f"Failed to set reference: {e}")


def ensure_sfreq(raw: mne.io.BaseRaw, target_sfreq: float) -> mne.io.BaseRaw:
    """Resample to the required sampling frequency."""
    if abs(float(raw.info["sfreq"]) - target_sfreq) > 1e-6:
        logger.info(f"Resampling from {raw.info['sfreq']} Hz to {target_sfreq} Hz")
        raw = raw.copy().resample(target_sfreq)
    return raw


def select_channels(raw: mne.io.BaseRaw) -> mne.io.BaseRaw:
    """Keep only the selected modelling channels."""
    picks = [ch for ch in TARGET_CHANNELS if ch in raw.ch_names]
    if not picks:
        return raw
    return raw.copy().pick(picks)


def apply_filters(raw: mne.io.BaseRaw, notch_freq: float) -> mne.io.BaseRaw:
    """Apply notch and band-pass filters."""
    raw = raw.copy().load_data()
    nyq = raw.info["sfreq"] / 2.0

    freqs = [notch_freq]
    if notch_freq * 2 < nyq:
        freqs.append(notch_freq * 2)

    logger.info(f"Notch filter frequencies: {freqs}")
    raw.notch_filter(freqs, picks="eeg", verbose="warning")
    raw.filter(BANDPASS[0], BANDPASS[1], picks="eeg", verbose="warning")

    return raw


