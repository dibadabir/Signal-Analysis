def load_participants_df(bids_root: Path) -> pd.DataFrame:
    """Load the participant metadata table."""
    return pd.read_csv(bids_root / "participants.tsv", sep="\t")


def build_subject_selection_map(df: pd.DataFrame) -> Dict[str, Dict]:
    """
    Build a map of which sessions to keep.

    Parkinson's participants:
        keep OFF-medication sessions only

    Control participants:
        keep available control sessions
    """
    required_cols = {"participant_id", "Group", "sess1_Med", "sess2_Med"}
    missing = required_cols - set(df.columns)
    if missing:
        raise ValueError(f"participants.tsv missing required columns: {missing}")

    selection_map: Dict[str, Dict] = {}

    for _, row in df.iterrows():
        pid = str(row["participant_id"]).strip()
        subj = pid.replace("sub-", "")
        group = str(row["Group"]).strip().upper()
        s1 = str(row["sess1_Med"]).strip().upper()
        s2 = str(row["sess2_Med"]).strip().upper()

        if group == "PD":
            selection_map[subj] = {
                "group": "PD",
                "sessions": {
                    "sess1": {"keep": s1 == "OFF", "med": "OFF" if s1 == "OFF" else None},
                    "sess2": {"keep": s2 == "OFF", "med": "OFF" if s2 == "OFF" else None},
                }
            }

        elif group in {"CTL", "CONTROL"}:
            s2_keep = s2 not in {"NO S2", "NONE", "NAN"}
            selection_map[subj] = {
                "group": "CTL",
                "sessions": {
                    "sess1": {"keep": True, "med": "CTL"},
                    "sess2": {"keep": s2_keep, "med": "CTL"},
                }
            }

    return selection_map


_SESSION_RE = re.compile(r"(?:ses(?:sion)?[-_]?)?0*([12])\b", re.IGNORECASE)

def session_entity_to_index(session_val) -> int:
    """Convert BIDS session string into 1 or 2 when possible."""
    if session_val is None:
        return -1

    m = _SESSION_RE.search(str(session_val).strip())
    if m:
        return int(m.group(1))

    return -1


def select_subject_files(
    layout: BIDSLayout,
    subj: str,
    selection_map: Dict[str, Dict]
) -> List[Tuple[str, str]]:
    """
    Return the list of EEG files to use for one subject together with
    the label that should be saved in the output file name.
    """
    info = selection_map.get(subj)
    if info is None:
        return []

    files = layout.get(
        subject=subj,
        extension=[".set", ".vhdr", ".edf", ".eeg", ".cnt", ".bdf"],
        return_type="filename"
    ) or []

    if not files:
        return []

    result: List[Tuple[str, str]] = []
    seen = set()

    for f in files:
        if f in seen:
            continue

        ent = layout.parse_file_entities(f)
        ses = ent.get("session")
        idx = session_entity_to_index(ses)

        if idx == 1:
            sess_key = "sess1"
        elif idx == 2:
            sess_key = "sess2"
        else:
            lf = f.lower()
            if any(tag in lf for tag in ["ses-1", "ses-01", "s1", "sess1"]):
                sess_key = "sess1"
            elif any(tag in lf for tag in ["ses-2", "ses-02", "s2", "sess2"]):
                sess_key = "sess2"
            else:
                sess_key = "sess1"

        sess_info = info["sessions"].get(sess_key, {"keep": False, "med": None})
        if sess_info["keep"] and sess_info["med"]:
            result.append((f, sess_info["med"]))
            seen.add(f)

    if not result and info["group"] == "CTL" and files:
        result = [(files[0], "CTL")]

    return result


