def get_events(raw: mne.io.BaseRaw):
    """
    Extract events from annotations when available.
    Falls back to find_events if needed.
    """
    if raw.annotations is not None and len(raw.annotations) > 0:
        try:
            return mne.events_from_annotations(raw, verbose="warning")
        except Exception:
            pass

    try:
        events = mne.find_events(raw, verbose="warning")
        event_id = {str(int(x)): int(x) for x in np.unique(events[:, 2])}
        return events, event_id
    except Exception:
        return np.empty((0, 3), dtype=int), {}


def epoch_target_only(raw: mne.io.BaseRaw, events, event_id) -> Epochs:
    """
    Create epochs using target events only and remove high-amplitude epochs.
    """
    picks = pick_types(raw.info, meg=False, eeg=True, eog=False, exclude="bads")

    present_codes = set(events[:, 2].tolist()) if len(events) > 0 else set()
    if EVENT_CODE_TARGET not in present_codes:
        raise ValueError(f"Target event code {EVENT_CODE_TARGET} not found in this file.")

    target_event_id = {EVENT_NAME_TARGET: EVENT_CODE_TARGET}

    epochs = Epochs(
        raw,
        events,
        event_id=target_event_id,
        tmin=TMIN,
        tmax=TMAX,
        baseline=BASELINE,
        preload=True,
        picks=picks,
        verbose="warning"
    )

    if len(epochs) > 0:
        ptp = np.ptp(epochs.get_data(), axis=2)
        keep = ~np.any(ptp > REJECT_PTP_EVENT, axis=1)
        epochs = epochs[np.where(keep)[0]]

    return epochs


