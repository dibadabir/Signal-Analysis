def save_fig(fig, save_path: Path):
    """Save a matplotlib figure and optionally display it."""
    fig.savefig(save_path, dpi=120, bbox_inches="tight")
    if SHOW_PLOTS:
        plt.show()
    plt.close(fig)


def qc_plots_for_subject(
    subj: str,
    raw_before: mne.io.BaseRaw,
    raw_after: mne.io.BaseRaw,
    ica: ICA,
    exclude: List[int],
    bad_channels: List[str]
):
    """Create simple quality-control plots for one subject."""
    print(f"--- QC for sub-{subj} ---")

    try:
        eeg_raw = raw_before.copy().pick("eeg")
        ch_sds = np.std(eeg_raw.get_data(), axis=1) * 1e6
        ch_names = eeg_raw.ch_names
        colours = ["red" if ch in bad_channels else "steelblue" for ch in ch_names]

        fig0, ax = plt.subplots(figsize=(max(10, len(ch_names) * 0.4), 4))
        ax.bar(range(len(ch_names)), ch_sds, color=colours)
        ax.set_xticks(range(len(ch_names)))
        ax.set_xticklabels(ch_names, rotation=90, fontsize=8)
        ax.set_ylabel("SD (µV)")
        ax.set_title(f"sub-{subj} channel SD")
        fig0.tight_layout()
        save_fig(fig0, PLOTS_DIR / f"sub-{subj}_bad_channels.png")
    except Exception as e:
        logger.info(f"Bad-channel QC plot failed: {e}")

    try:
        fig1 = raw_before.copy().pick("eeg").plot_psd(fmin=1, fmax=40, show=False)
        fig1.suptitle(f"sub-{subj} PSD before cleaning")
        save_fig(fig1, PLOTS_DIR / f"sub-{subj}_psd_before.png")
    except Exception as e:
        logger.info(f"PSD before plot failed: {e}")

    try:
        fig2 = raw_after.copy().pick("eeg").plot_psd(fmin=1, fmax=40, show=False)
        fig2.suptitle(f"sub-{subj} PSD after cleaning")
        save_fig(fig2, PLOTS_DIR / f"sub-{subj}_psd_after.png")
    except Exception as e:
        logger.info(f"PSD after plot failed: {e}")

    try:
        fig3 = ica.plot_overlay(raw_after, exclude=exclude, picks="eeg", show=False)
        if isinstance(fig3, list):
            fig3 = fig3[0]
        fig3.suptitle(f"sub-{subj} ICA overlay")
        save_fig(fig3, PLOTS_DIR / f"sub-{subj}_ica_overlay.png")
    except Exception as e:
        logger.info(f"ICA overlay plot failed: {e}")


