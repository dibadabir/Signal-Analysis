# 14. Main preprocessing routine
# ------------------------------------------------------------
def run_preprocessing():
    """
    Main pipeline:
    - select PD OFF and CTL sessions
    - load raw EEG
    - clean channels and artefacts
    - filter and resample
    - keep target-event epochs only
    - save each subject/session as .fif for downstream SVM features
    """
    assert_path_ok()
    logger.info("Paths look OK.")

    layout = BIDSLayout(str(BIDS_ROOT), validate=False)
    participants_df = load_participants_df(BIDS_ROOT)
    selection_map = build_subject_selection_map(participants_df)

    subjects = sorted(selection_map.keys())
    logger.info(f"Subjects considered: {len(subjects)}")

    subject_summary: List[Dict] = []
    saved_subjects: List[str] = []
    attempted_subjects = 0
    unsaved_subjects_in_a_row = 0

    for subj in tqdm(subjects, desc="Preprocessing PD OFF vs CTL subjects"):
        attempted_subjects += 1
        print(f"\n========== Processing sub-{subj} ==========")

        files_and_labels = select_subject_files(layout, subj, selection_map)

        if not files_and_labels:
            logger.warning(f"sub-{subj}: no matching EEG files found.")
            subject_summary.append({
                "subject": subj,
                "group": selection_map[subj]["group"],
                "med_status": "UNKNOWN",
                "condition_saved": "",
                "n_epochs": 0,
                "n_channels": 0,
                "bad_channels": "",
                "ica_components": "",
                "notch_hz": "",
                "notes": "no matching files"
            })
            unsaved_subjects_in_a_row += 1

            if (
                attempted_subjects <= MAX_INITIAL_SUBJECTS_WITHOUT_SAVE
                and not saved_subjects
                and unsaved_subjects_in_a_row >= MAX_INITIAL_SUBJECTS_WITHOUT_SAVE
            ):
                raise RuntimeError("The first few subjects produced no savable data.")
            continue

        for f, med_label in files_and_labels:
            print(f"--- File: {Path(f).name} | Save label: {med_label} ---")

            epochs_list: List[mne.Epochs] = []
            subj_bad_channels: List[str] = []
            subj_ica_ncomp: List[int] = []
            last_notch_freq = DEFAULT_NOTCH_FREQ

            try:
                ent = layout.parse_file_entities(f)
                bids_path = BIDSPath(root=BIDS_ROOT, **ent)

                notch_freq = read_sidecar_notch_freq(bids_path)
                ref_ch, ground_ch = read_sidecar_ref_and_ground(bids_path)
                coord_system = read_coordsystem(bids_path)
                has_eog, has_ecg = read_sidecar_channel_counts(bids_path)
                last_notch_freq = notch_freq

                raw = read_raw_bids(bids_path=bids_path, verbose="warning")
                raw = force_eeg_channel_types(raw)
                safe_set_montage(raw, coord_system=coord_system)

                raw, bad_channels = detect_and_interpolate_bad_channels(
                    raw=raw,
                    subj=subj,
                    fname=Path(f).name
                )
                subj_bad_channels.extend(bad_channels)

                safe_set_reference(raw, ref_ch=ref_ch, ground_ch=ground_ch)
                raw = apply_filters(raw, notch_freq=notch_freq)
                raw = ensure_sfreq(raw, RESAMPLE_SFREQ)

                n_eeg_full = len(raw.copy().pick_types(eeg=True).ch_names)
                if n_eeg_full < 8:
                    logger.warning(f"sub-{subj} [{med_label}]: too few EEG channels before selection.")
                    continue

                raw_before = raw.copy()
                raw_filt = raw.copy()

                ica = fit_ica(raw_filt, subj=subj)
                subj_ica_ncomp.append(ica.n_components_)

                raw_clean, exclude = apply_ica(
                    ica=ica,
                    raw_filt=raw_filt,
                    has_eog=has_eog,
                    has_ecg=has_ecg
                )

                raw_clean = select_channels(raw_clean)
                raw_before_sel = select_channels(raw_before)

                n_eeg = len(raw_clean.copy().pick_types(eeg=True).ch_names)
                if n_eeg < 8:
                    logger.warning(f"sub-{subj} [{med_label}]: too few EEG channels after selection.")
                    continue

                events, event_id = get_events(raw_clean)
                if events.size == 0 or not event_id:
                    logger.warning(
                        f"sub-{subj} [{med_label}]: no valid events found. "
                        f"Skipping because the SVM pipeline needs consistent event-based epochs."
                    )
                    continue

                epochs = epoch_target_only(raw_clean, events, event_id)
                if len(epochs) == 0:
                    logger.warning(f"sub-{subj} [{med_label}]: no usable target epochs after rejection.")
                    continue

                qc_plots_for_subject(
                    subj=subj,
                    raw_before=raw_before_sel,
                    raw_after=raw_clean,
                    ica=ica,
                    exclude=exclude,
                    bad_channels=bad_channels
                )

                epochs_list.append(epochs)

            except Exception as e:
                logger.warning(f"sub-{subj} [{med_label}]: preprocessing failed -> {e}")

            if not epochs_list:
                subject_summary.append({
                    "subject": subj,
                    "group": selection_map[subj]["group"],
                    "med_status": med_label,
                    "condition_saved": EVENT_NAME_TARGET,
                    "n_epochs": 0,
                    "n_channels": 0,
                    "bad_channels": "; ".join(sorted(set(subj_bad_channels))),
                    "ica_components": "; ".join(map(str, subj_ica_ncomp)),
                    "notch_hz": last_notch_freq,
                    "notes": "no usable target epochs"
                })
                unsaved_subjects_in_a_row += 1
                continue

            merged = mne.concatenate_epochs(epochs_list)
            out_path = CACHE_EPOCHS / f"sub-{subj}_{med_label}-epo.fif"
            merged.save(str(out_path), overwrite=True)
            assert_epochs_saved(out_path)

            saved_subjects.append(subj)
            unsaved_subjects_in_a_row = 0

            subject_summary.append({
                "subject": subj,
                "group": selection_map[subj]["group"],
                "med_status": med_label,
                "condition_saved": EVENT_NAME_TARGET,
                "n_epochs": len(merged),
                "n_channels": len(merged.ch_names),
                "bad_channels": "; ".join(sorted(set(subj_bad_channels))),
                "ica_components": "; ".join(map(str, subj_ica_ncomp)),
                "notch_hz": last_notch_freq,
                "notes": ""
            })

            print(
                f"Saved: {out_path.name} | "
                f"group={selection_map[subj]['group']} | "
                f"med={med_label} | "
                f"condition={EVENT_NAME_TARGET} | "
                f"epochs={len(merged)} | "
                f"channels={len(merged.ch_names)}"
            )

    epoch_files = sorted(CACHE_EPOCHS.glob("sub-*-epo.fif"))

    summary_df = pd.DataFrame(subject_summary)
    summary_path = OUT_DIR / "preprocessing_summary.tsv"
    summary_df.to_csv(summary_path, sep="\t", index=False)

    logger.info(f"Saved subjects: {len(saved_subjects)}")
    logger.info(f"Epoch files: {len(epoch_files)}")
    logger.info(f"Epoch folder: {CACHE_EPOCHS}")
    logger.info(f"QC folder: {PLOTS_DIR}")
    logger.info(f"Summary written to: {summary_path}")

    if len(epoch_files) == 0:
        raise RuntimeError("No epoch files were saved.")

    print("\nPreprocessing complete.")
    print(f"Saved epochs use condition: {EVENT_NAME_TARGET} (code {EVENT_CODE_TARGET})")
    print("Parkinson's sessions kept: OFF only")
    print("Control sessions kept: CTL")


# ------------------------------------------------------------
# 15. Run
# ------------------------------------------------------------
run_preprocessing()
