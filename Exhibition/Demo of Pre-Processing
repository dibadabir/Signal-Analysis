"""# ICA-Based Artifact Removal
Independent Component Analysis (ICA) was applied to identify artefacts such as eye blinks and physiological noise.
Identified components were removed to improve signal clarity while preserving neural activity.
"""

def apply_ica(ica, raw_filt, has_eog=False, has_ecg=False):
    bad_components = []

    if not bad_components:
        for proxy in ["Fp1", "Fp2", "FP1", "FP2"]:
            if proxy in raw_filt.ch_names:
                inds, _ = ica.find_bads_eog(raw_filt, ch_name=proxy)
                bad_components.extend(list(inds))
                break

    bad_components = sorted(set(bad_components))[:2]
    raw_clean = raw_filt.copy()
    ica.apply(raw_clean, exclude=bad_components)

    return raw_clean, bad_components

"""# Filtering and Sampling
A notch filter removed power line noise, and a band-pass filter retained relevant EEG frequencies.
The data was then resampled to a consistent frequency to standardise processing and reduce complexity.
"""

RESAMPLE_SFREQ = 250.0
BANDPASS = (0.5, 40.0)
DEFAULT_NOTCH_FREQ = 50.0

def apply_filters(raw, notch_freq):
    raw = raw.copy().load_data()
    raw.notch_filter([notch_freq], picks="eeg", verbose="warning")
    raw.filter(0.5, 40.0, picks="eeg", verbose="warning")
    return raw

def ensure_sfreq(raw, target_sfreq):
    return raw.copy().resample(target_sfreq)

